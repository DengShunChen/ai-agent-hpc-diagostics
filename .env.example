# Copy to .env and fill in locally. NEVER commit .env.
# No LLM provider is used in Iteration 1; these are placeholders for later iterations.

# e.g. azure-openai, foundry
MODEL_PROVIDER=
MODEL_NAME=
MODEL_ENDPOINT=
# Supply via environment or a secret store. Never hard-code.
MODEL_API_KEY=

LOG_LEVEL=INFO

# Optional: override the root directory holding fixtures/, test_data/, knowledge/
# HPC_AGENT_DATA_ROOT=
