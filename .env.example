# Copy to .env and fill in locally. NEVER commit .env.
# Optional LLM. Leave MODEL_PROVIDER empty to run without an LLM.
# Supported: ollama (local, the default choice) or anthropic (Claude, cloud: allowed only when
# fixtures/DATA_CLASS.json says "synthetic" or "deidentified-import"; every request is scanned
# for credentials and identifiers before it leaves). The Ollama endpoint must be on this machine.
MODEL_PROVIDER=
# e.g. qwen2.5:3b. Ollama ":cloud" models are refused unless HPC_AGENT_LLM_ALLOW_CLOUD=1.
MODEL_NAME=
# Default http://127.0.0.1:11434 (inside the container: http://host.containers.internal:11434)
MODEL_ENDPOINT=
# Seconds to wait for the local model (CPU inference can be slow)
HPC_AGENT_LLM_TIMEOUT=300
# Who reasons in triage and the specialist agents: llm (the model chooses tools and proposes
# hypotheses; deterministic checks keep only grounded proposals; rules are the fallback) or rules.
# Default: rules (llm is opt-in; see docs/evaluation-llm.md). Recommended model: qwen2.5:7b or larger.
HPC_AGENT_REASONING=
# Claude: the SDK reads ANTHROPIC_API_KEY from the environment (or an `ant auth login` profile).
# Set it in your shell or secret store, never in a committed file. MODEL_NAME defaults to claude-opus-5-5.
# HPC_AGENT_CLAUDE_EFFORT=high

LOG_LEVEL=INFO

# Optional: override the root directory holding fixtures/, test_data/, knowledge/
# HPC_AGENT_DATA_ROOT=
