# Copy to .env and fill in locally. NEVER commit .env.
# Optional local LLM explainer. Leave MODEL_PROVIDER empty to run without an LLM.
# Supported: ollama (local only). The endpoint must be on this machine.
MODEL_PROVIDER=
# e.g. qwen2.5:3b. Ollama ":cloud" models are refused unless HPC_AGENT_LLM_ALLOW_CLOUD=1.
MODEL_NAME=
# Default http://127.0.0.1:11434 (inside the container: http://host.containers.internal:11434)
MODEL_ENDPOINT=
# Seconds to wait for the local model (CPU inference can be slow)
HPC_AGENT_LLM_TIMEOUT=300
# Not used by the local Ollama provider. Never hard-code keys.
MODEL_API_KEY=

LOG_LEVEL=INFO

# Optional: override the root directory holding fixtures/, test_data/, knowledge/
# HPC_AGENT_DATA_ROOT=
